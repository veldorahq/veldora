# Dependencies
/vendor/
/node_modules/

# Environment
.env
.env.*
!.env.example

# Playground & Scratch
/playground/
/scratch/
*.ps1
*.bat

# Build & Test outputs
.phpunit.cache/
.phpunit.result.cache
*.vsix

# Cache and Storage
/storage/framework/cache/*
/storage/framework/views/*
/storage/framework/sessions/*
/storage/logs/*
!/storage/app/.gitkeep
!/storage/framework/cache/.gitkeep
!/storage/framework/views/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/logs/.gitkeep
/storage/*.sqlite
/storage/*.sqlite-journal

# Database files
/database/*.sqlite
/database/*.sqlite-journal
!/database/.gitkeep

# System files
*.log
.DS_Store
Thumbs.db

# Sibling ecosystem repositories (managed in their own repos)
/veldora-core/
/veldora-ui/
/create-veldora-app/
/docs-site/
/veldora-vscode/

# Internal private planning notes (ignored in public starter app)
/ARCHITECTURE.md
/ABOUT.md
/docs.md
/assets/
/default-favicon/
/phpstan.neon
/phpunit.xml
/composer.lock
