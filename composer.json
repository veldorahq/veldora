{
    "name": "veldora/veldora",
    "description": "The Veldora PHP Framework Starter Application",
    "keywords": ["framework", "veldora", "php", "starter", "template"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2 || ^8.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Veldora\\Framework\\": "src/Framework/",
            "Veldora\\UI\\": "src/UI/"
        },
        "files": [
            "src/Framework/helpers.php",
            "bootstrap/Polyfill.php"
        ]
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php veldora key:generate"
        ],
        "serve": "php veldora serve",
        "migrate": "php veldora migrate"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}