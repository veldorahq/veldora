{
    "name": "veldora/veldora",
    "type": "project",
    "description": "The Veldora PHP Framework Starter Application",
    "keywords": ["framework", "veldora", "php", "starter", "template"],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3",
        "veldora/framework": "^0.5.7",
        "veldora/ui": "^0.5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php veldora key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php veldora migrate --graceful"
        ],
        "serve": "php veldora serve",
        "migrate": "php veldora migrate",
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
