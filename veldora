/**
 * Format and colorize PHP built-in server request logs.
 */
function colorizeServerLog(string $line): ?string
{
    $line = trim($line);
    if ($line === '') {
        return null;
    }

    if (str_contains($line, 'Accepted') || str_contains($line, 'Closing') || str_contains($line, 'Development Server') || str_contains($line, 'started')) {
        return null;
    }

    if (preg_match('/\[(.*?)\] (?:[\d\.:]+) \[(\d{3})\]: ([A-Z]+) (.*)/', $line, $m)) {
        $timeStr = date('h:i:s A', strtotime($m[1]) ?: time());
        $status = (int) $m[2];
        $method = $m[3];
        $uri = $m[4];

        if ($status >= 200 && $status < 300) {
            $statusStr = "\033[32m\033[1m" . $status . " OK\033[0m";
        } elseif ($status >= 300 && $status < 400) {
            $statusStr = "\033[36m" . $status . "\033[0m";
        } elseif ($status >= 400 && $status < 500) {
            $statusStr = "\033[33m" . $status . " Not Found\033[0m";
        } else {
            $statusStr = "\033[31m\033[1m" . $status . " Error\033[0m";
        }

        $methodStr = "\033[35m\033[1m" . str_pad($method, 6) . "\033[0m";
        $uriStr = ($status === 404) ? ("\033[90m" . $uri . "\033[0m") : ("\033[97m" . $uri . "\033[0m");

        return "  \033[90m" . $timeStr . "\033[0m  " . $statusStr . "  " . $methodStr . " " . $uriStr;
    }

    if (str_contains($line, 'error') || str_contains($line, 'Fatal') || str_contains($line, 'Exception') || str_contains($line, 'Stack trace:')) {
        return "  \033[31m\033[1m✖\033[0m \033[31m" . $line . "\033[0m";
    }

    return "  \033[90m" . $line . "\033[0m";
}

